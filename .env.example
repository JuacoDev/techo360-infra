# ============================================================
# Techo 360 - Variables de entorno
# ------------------------------------------------------------
# Copia este archivo como ".env" y completa los valores reales.
# El ".env" real NUNCA se sube a git (ver .gitignore).
# ============================================================

# --- Base de datos PRINCIPAL (PostGIS: mapa de calor) ---
DB_PRINCIPAL_NAME=techo360_principal
DB_PRINCIPAL_USER=techo360_backend
DB_PRINCIPAL_PASSWORD=cambia-esta-contrasena-1

# --- Base de datos VECTORIAL (pgvector: compartida Chatbot + Proyeccion) ---
DB_VECTOR_NAME=techo360_vector
DB_VECTOR_USER=techo360_ia
DB_VECTOR_PASSWORD=cambia-esta-contrasena-2

# --- Base de datos de USUARIOS / LOGS ---
DB_USERS_NAME=techo360_usuarios
DB_USERS_USER=techo360_users
DB_USERS_PASSWORD=cambia-esta-contrasena-3

# --- RabbitMQ ---
RABBITMQ_USER=techo360
RABBITMQ_PASSWORD=cambia-esta-contrasena-4

# --- Etiqueta de imagen a desplegar ---
# "dev" = ultima version en desarrollo (se actualiza en cada push)
# usa el nombre de una etiqueta congelada (ver scripts/freeze-tag.sh)
# antes de una entrega/demo para no arriesgar cambios de ultima hora
TAG=dev

# --- Base de datos de DESARROLLO/pruebas (docker-compose.dev-db.yml) ---
DEV_POSTGRES_DB=techo360_dev
DEV_POSTGRES_USER=techo360_dev_user
DEV_POSTGRES_PASSWORD=cambia-esta-otra-contrasena

# --- Pendientes de agregar cuando esten definidos ---
# BREVO_API_KEY=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# JWT_SECRET_KEY=
