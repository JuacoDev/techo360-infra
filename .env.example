# ============================================================
# Techo 360 - Variables de entorno
# ------------------------------------------------------------
# Copia este archivo como ".env" y completa los valores reales.
# El ".env" real NUNCA se sube a git (ver .gitignore).
# ============================================================

# --- Base de datos de PRODUCCION ---
POSTGRES_DB=techo360_db
POSTGRES_USER=techo360_user
POSTGRES_PASSWORD=cambia-esta-contrasena

# --- Etiqueta de imagen a desplegar ---
# "dev" = ultima version en desarrollo (se actualiza en cada push)
# usa el nombre de una etiqueta congelada (ver scripts/freeze-tag.sh)
# antes de una entrega/demo para no arriesgar cambios de ultima hora
TAG=dev

# --- Base de datos de DESARROLLO/pruebas (docker-compose.dev-db.yml) ---
DEV_POSTGRES_DB=techo360_dev
DEV_POSTGRES_USER=techo360_dev_user
DEV_POSTGRES_PASSWORD=cambia-esta-otra-contrasena
